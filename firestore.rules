rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'timeZone', 'language', 'createdAt'])
        && request.resource.data.timeZone is string
        && request.resource.data.language in ['ja', 'en']
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'timeZone', 'language', 'defaultView', 'dueReminders', 'dailyGroup',
                       'dailyTime', 'introHidden', 'photoURL', 'emailNotify', 'email', 'pinnedProjects'])
        // ホームで上に留めたプロジェクト（id の並び。20件まで）
        && (!('pinnedProjects' in request.resource.data)
            || (request.resource.data.pinnedProjects is list && request.resource.data.pinnedProjects.size() <= 20))
        // メールアドレスの写しは、ログインのアドレスと同じ値にそろえるときだけ
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || request.resource.data.email == request.auth.token.email)
        // メールで受け取る通知のまとまり（決まった名前だけ）
        && (!('emailNotify' in request.resource.data)
            || (request.resource.data.emailNotify is list
                && request.resource.data.emailNotify.hasOnly(['daily', 'assign', 'comment', 'status', 'request', 'reminder'])))
        // アイコンの写真：URL か、外したときの null
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000))
        // 「ようこそ」の箱を「後で見る」で閉じた印
        && (!('introHidden' in request.resource.data) || request.resource.data.introHidden is bool)
        && (!('defaultView' in request.resource.data) || request.resource.data.defaultView in ['list', 'board'])
        && (!('dailyGroup' in request.resource.data) || request.resource.data.dailyGroup in ['due', 'priority', 'assignee'])
        // 毎朝のまとめの時刻：0時からの分で、10分刻み（関数は === で比べるので、ずれると届かなくなる）
        // 'off' は「毎日のまとめを届けない」
        && (!('dailyTime' in request.resource.data)
            || request.resource.data.dailyTime == 'off'
            || (request.resource.data.dailyTime is int
                && request.resource.data.dailyTime >= 0 && request.resource.data.dailyTime < 1440
                && request.resource.data.dailyTime % 10 == 0))
        && (!('dueReminders' in request.resource.data)
            || (request.resource.data.dueReminders is list
                && request.resource.data.dueReminders.hasOnly(['today', 'tomorrow', 'in3'])));
      // 受信箱：本人だけが読み書きできる
      match /inbox/{mid} {
        function validMemo() {
          let d = request.resource.data;
          return d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && d.body is string && d.body.size() <= 5000;
        }
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['title', 'body', 'createdAt', 'updatedAt'])
          && validMemo()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        // 直す・ゴミ箱に入れる・戻す
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['title', 'body', 'createdAt', 'updatedAt', 'discardedAt', 'expireAt', 'pinned'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'updatedAt', 'discardedAt', 'expireAt', 'pinned'])
          && request.resource.data.get('pinned', false) is bool
          && validMemo()
          && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp);
      }

          // 通知：本人だけが読む・既読にする・消す。
      // 作れるのは「自分も宛先も、そのプロジェクトのメンバー」のときだけ（自分宛ては作らない）
      match /notifications/{nid} {
        function validNotification() {
          let d = request.resource.data;
          let keys = ['type', 'pid', 'projectName', 'iid', 'issueNumber', 'issueTitle',
                      'by', 'byName', 'detail', 'at', 'read', 'expireAt'];
          return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
            && d.type in ['assigned', 'comment', 'dueChanged', 'resolved', 'sentBack',
                          'closed', 'rejected', 'restored', 'joined', 'handover', 'merged', 'subtaskAssigned',
                          'mention', 'watchResolved', 'request', 'requestDone', 'requestDeclined', 'reminder',
                          'subtaskReminder']
            && d.pid is string
            && d.projectName is string && d.projectName.size() <= 100
            && (d.iid == null || d.iid is string)
            && (d.issueNumber == null || d.issueNumber is int)
            && d.issueTitle is string && d.issueTitle.size() <= 200
            && d.by == request.auth.uid
            && d.byName is string && d.byName.size() <= 100
            && d.detail is string && d.detail.size() <= 200
            && d.at == request.time
            && d.read == false
            && d.expireAt is timestamp
            // 「書く前」を見る（自分から抜けるときは、同じ保存で自分のメンバー文書が消えるため）
            && exists(/databases/$(database)/documents/projects/$(d.pid)/members/$(request.auth.uid))
            && exists(/databases/$(database)/documents/projects/$(d.pid)/members/$(uid));
        }
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // 既読・未読、ピン止め。ピン止めしたら expireAt を消し（自動で消えない）、外したら入れ直す
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'pinned', 'expireAt'])
          && request.resource.data.read is bool
          && request.resource.data.get('pinned', false) is bool
          && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp);
        allow create: if request.auth != null && request.auth.uid != uid && validNotification();
      }  
      // プッシュ通知を受け取る端末（本人だけ。関数は Admin なので、これに関係なく読める）
      match /devices/{fid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['fid', 'createdAt'])
          && request.resource.data.fid == fid
          && request.resource.data.createdAt is timestamp;
      }
      // 課題のリマインド：本人だけ。文書の名前は「プロジェクトid_課題id」（1つの課題に1つ。置き直すと上書き）
      match /reminders/{rid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['pid', 'iid', 'sid', 'subTitle', 'number', 'title', 'projectName', 'at', 'createdAt'])
          // 課題のリマインドは「pid_iid」、サブタスクのリマインドは「pid_iid_sid」
          && (rid == request.resource.data.pid + '_' + request.resource.data.iid
              || (request.resource.data.get('sid', null) is string
                  && rid == request.resource.data.pid + '_' + request.resource.data.iid + '_' + request.resource.data.sid))
          && request.resource.data.get('subTitle', '') is string && request.resource.data.get('subTitle', '').size() <= 200
          && request.resource.data.number is int
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.projectName is string && request.resource.data.projectName.size() <= 100
          && request.resource.data.at is timestamp
          && request.resource.data.createdAt is timestamp
          // 自分がメンバーのプロジェクトの課題にだけ置ける
          && exists(/databases/$(database)/documents/projects/$(request.resource.data.pid)/members/$(uid));
      }
      // 保存した絞り込み：本人だけ。条件は URL の ? より後ろの文字列をそのまま持つ。
      // 1プロジェクト20個まで・同じ名前は上書き、は画面で守る（ルールは数えられないため）
      match /filters/{fid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'pid', 'query', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
          && request.resource.data.pid is string
          && request.resource.data.query is string && request.resource.data.query.size() <= 2000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time
          // 自分がメンバーのプロジェクトの分だけ
          && exists(/databases/$(database)/documents/projects/$(request.resource.data.pid)/members/$(uid));
      }
    }
    function signedIn() { return request.auth != null; }
    function projectPath(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function memberPath(pid) { return /databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid); }
    function isMember(pid) { return signedIn() && exists(memberPath(pid)); }
    function isAdmin(pid) { return isMember(pid) && get(memberPath(pid)).data.role == 'admin'; }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function myInvitationPath(pid) {
      return /databases/$(database)/documents/projects/$(pid)/invitations/$(request.auth.token.email.lower());
    }
    function validMember(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'photoURL', 'joinedAt']);
    }
    function canWrite(pid) {
      return isMember(pid)
        && get(memberPath(pid)).data.role in ['admin', 'member']
        && get(projectPath(pid)).data.archived == false;
    }
        function myRole(pid) { return get(memberPath(pid)).data.role; }

    function resolutionOk() {
      let d = request.resource.data;
      return validHours(d, 'actualHours')
        && d.cause is string && d.cause.size() > 0
        && d.countermeasure is string && d.countermeasure.size() > 0
        && d.causeCategory in ['requirements', 'design', 'testing', 'operation', 'communication', 'external', 'other']
        && d.doneCriteriaMet == true
        && d.resolvedAt == request.time
        && d.resolvedAssignee == resource.data.assigneeId
        // 回避策が入っているなら、外したことを確かめてから
        && (resource.data.get('workaround', '') == ''
            || resource.data.get('workaroundEnded', false) == true
            || d.get('workaroundEnded', false) == true);
    }

    function closeOk() {
      let d = request.resource.data;
      return d.effect in ['yes', 'partial', 'no']
        && d.learning is string
        && d.doneCriteriaMet == true
        && d.closedAt == request.time;
    }

    // プロジェクトの設定：整数で、範囲の中（関数は notifyHour を === で比べるため、整数でないと届かなくなる）
    function validSettings(s) {
      return s.notifyHour is int && s.notifyHour >= 0 && s.notifyHour <= 23
        && s.staleDays is int && s.staleDays >= 1 && s.staleDays <= 90
        && s.effectCheckDays is int && s.effectCheckDays >= 1 && s.effectCheckDays <= 90
        && s.highPriorityLimit is int && s.highPriorityLimit >= 1 && s.highPriorityLimit <= 100;
    }

    // アーカイブ・解除：アーカイブするときは種類と理由が必須。解除するときは、アーカイブの情報を消す
    function archiveOk() {
      let d = request.resource.data;
      return (resource.data.archived == false && d.archived == true
          && d.archiveKind in ['completed', 'cancelled']
          && d.archiveReason is string && d.archiveReason.size() > 0 && d.archiveReason.size() <= 1000
          && d.archivedAt == request.time
          && d.archivedBy == request.auth.uid)
        || (resource.data.archived == true && d.archived == false
          && !d.keys().hasAny(['archiveKind', 'archiveReason', 'archivedAt', 'archivedBy']));
    }

    // 課題の作成で、ふだんの登録と取り込みに共通する形
    function issueShapeOk(pid) {
      let d = request.resource.data;
      return (!('relatedFrom' in d)
          || (d.relatedFrom.keys().hasOnly(['kind', 'iid', 'number'])
              && d.relatedFrom.kind in ['prevention']
              && d.relatedFrom.iid is string
              && d.relatedFrom.number is int))
        && (d.get('occurredOn', null) == null || d.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.get('impact', '') is string && d.get('impact', '').size() <= 200
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.priorityOverride == null
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.labelIds is list && d.labelIds.size() <= 5
        && d.type in ['bug', 'request', 'question', 'task', 'risk']
        && d.importance in ['high', 'mid', 'low']
        && d.dueAt is timestamp
        && (!('firstDueAt' in d) || d.firstDueAt == d.dueAt)
        && d.doneCriteria is string && d.doneCriteria.size() > 0
        // 担当者は、このプロジェクトの管理者かメンバー
        && get(/databases/$(database)/documents/projects/$(pid)/members/$(d.assigneeId)).data.role in ['admin', 'member']
        // 番号は、採番した値と一致
        && d.number == getAfter(projectPath(pid)).data.issueSeq
        && getAfter(projectPath(pid)).data.issueSeq == get(projectPath(pid)).data.issueSeq + 1
        && validHours(d, 'estimateHours');
    }

    // ふだんの登録：提起者は本人、未着手、登録日時は今（過去の日付の課題は作れない）
    function normalCreateOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'number', 'title', 'type', 'status', 'importance', 'priorityOverride', 'dueAt', 'firstDueAt',
               'startAt', 'doneCriteria', 'description', 'assigneeId', 'reporterId', 'labelIds',
               'createdAt', 'updatedAt', 'updatedBy', 'occurredOn', 'impact', 'relatedFrom', 'estimateHours'])
        && d.reporterId == request.auth.uid
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    // 取り込み：メンバーは、提起者は本人・未着手か対応中・登録日時は今。
    // 管理者は、提起者（このプロジェクトのメンバー）・ステータス・過去の日時を指定できる
    function importCreateOk(pid) {
      let d = request.resource.data;
      let done = ['cause', 'countermeasure', 'causeCategory', 'effect', 'learning', 'resolvedAt', 'closedAt'];
      return d.keys().hasOnly([
               'number', 'title', 'type', 'status', 'importance', 'priorityOverride', 'dueAt', 'firstDueAt',
               'startAt', 'doneCriteria', 'description', 'assigneeId', 'reporterId', 'labelIds',
               'createdAt', 'updatedAt', 'updatedBy', 'occurredOn', 'impact',
               'importId', 'importedBy', 'cause', 'countermeasure', 'causeCategory', 'effect', 'learning',
               'resolvedAt', 'closedAt', 'resolvedAssignee'])
        && d.importId is string && d.importId.size() > 0
        && d.importedBy == request.auth.uid
        && (
          (myRole(pid) != 'admin'
            && d.reporterId == request.auth.uid
            && d.status in ['open', 'in_progress']
            && d.createdAt == request.time
            && !d.keys().hasAny(done))
          ||
          (myRole(pid) == 'admin'
            && exists(/databases/$(database)/documents/projects/$(pid)/members/$(d.reporterId))
            && d.status in ['open', 'in_progress', 'on_hold', 'resolved', 'closed', 'rejected']
            && d.createdAt is timestamp && d.createdAt <= request.time
            && (!('resolvedAt' in d) || (d.resolvedAt is timestamp && d.resolvedAt <= request.time))
            && (!('closedAt' in d) || (d.closedAt is timestamp && d.closedAt <= request.time)))
        );
    }

    // 取り込みの取り消し：取り込んだ本人が、24時間以内に、自分が取り込んだ課題だけ削除フォルダへ
    function importUndoAllowed() {
      return resource.data.get('importedBy', '') == request.auth.uid
        && request.time < resource.data.createdAt + duration.value(1, 'd');
    }

    // 工数（時間）：未入力か、0〜999 の数（0.5刻みは画面でそろえる）
    function validHours(d, k) {
      return d.get(k, null) == null
        || (d.get(k, null) is number && d.get(k, null) >= 0 && d.get(k, null) <= 999);
    }

    function hasReason() {
      return request.resource.data.statusReason is string
        && request.resource.data.statusReason.size() > 0;
    }

    // 確定した変更の表と同じ決まり
    function statusChangeAllowed(pid) {
      let admin = myRole(pid) == 'admin';
      let worker = admin || resource.data.assigneeId == request.auth.uid;
      let owner = admin || resource.data.reporterId == request.auth.uid;
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (worker && from == 'open' && to == 'in_progress')
        || (worker && from == 'in_progress' && to == 'open')
        || (worker && from in ['open', 'in_progress'] && to == 'on_hold' && hasReason())
        || (worker && from == 'on_hold' && to == 'in_progress')
        || (worker && from == 'in_progress' && to == 'resolved' && resolutionOk())
        || (owner && from == 'resolved' && to == 'in_progress' && hasReason())
        || (owner && from == 'resolved' && to == 'closed' && closeOk())
        || (admin && from in ['open', 'in_progress', 'on_hold'] && to == 'rejected' && hasReason())
        || (admin && from == 'rejected' && to == 'open' && hasReason())
        || (admin && from == 'closed' && to == 'in_progress' && hasReason());
    }

        // 編集：提起者・担当者・管理者。クローズ後は不可
    function editAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
               'title', 'type', 'importance', 'dueAt', 'assigneeId', 'doneCriteria', 'description', 'labelIds',
               'updatedAt', 'updatedBy', 'occurredOn', 'impact', 'estimateHours', 'actualHours'])
        && validHours(d, 'estimateHours') && validHours(d, 'actualHours')
        && (d.get('occurredOn', null) == null || d.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.get('impact', '') is string && d.get('impact', '').size() <= 200
        && d.labelIds is list && d.labelIds.size() <= 5
        && !(resource.data.status in ['closed', 'deleted', 'merged'])
        && (myRole(pid) == 'admin'
            || resource.data.reporterId == request.auth.uid
            || resource.data.assigneeId == request.auth.uid)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.type in ['bug', 'request', 'question', 'task', 'risk']
        && d.importance in ['high', 'mid', 'low']
        && d.dueAt is timestamp
        && d.doneCriteria is string && d.doneCriteria.size() > 0
        && get(/databases/$(database)/documents/projects/$(pid)/members/$(d.assigneeId)).data.role in ['admin', 'member'];
    }

    // 優先度の手動変更：担当者と管理者。クローズ・却下は不可
    function priorityAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['priorityOverride', 'updatedAt', 'updatedBy'])
        && resource.data.status in ['open', 'in_progress', 'on_hold']
        && (myRole(pid) == 'admin' || resource.data.assigneeId == request.auth.uid)
        && (d.priorityOverride == null || d.priorityOverride in ['high', 'mid', 'low']);
    }

    // 原因・対策の記入：担当者と管理者。対応中・保留のときだけ（解決済みにする前の下書き。どれも任意）
    function causeAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(['cause', 'countermeasure', 'causeCategory', 'updatedAt', 'updatedBy'])
        && resource.data.status in ['in_progress', 'on_hold']
        && (myRole(pid) == 'admin' || resource.data.assigneeId == request.auth.uid)
        && d.get('cause', '') is string && d.get('cause', '').size() <= 2000
        && d.get('countermeasure', '') is string && d.get('countermeasure', '').size() <= 2000
        && (d.get('causeCategory', null) == null
            || d.causeCategory in ['requirements', 'design', 'testing', 'operation', 'communication', 'external', 'other']);
    }

    // 回避策：担当者と管理者。未完了のときだけ。書き直したら「外した」の印は戻す
    function workaroundAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['workaround', 'workaroundEnded', 'updatedAt', 'updatedBy'])
        && resource.data.status in ['open', 'in_progress', 'on_hold']
        && (myRole(pid) == 'admin' || resource.data.assigneeId == request.auth.uid)
        && d.workaround is string && d.workaround.size() <= 2000
        // 書く・書き直す（適用中にする）か、文章はそのままで「やめた」にするか
        && (d.workaroundEnded == false
            || (d.workaroundEnded == true && d.workaround == resource.data.get('workaround', '')));
    }

    // 統合：管理者のみ。統合元・統合先とも同じプロジェクトの未クローズ。理由必須。統合済みからは出られない（元に戻せない）
    function mergeAllowed(pid, iid) {
      let d = request.resource.data;
      let open = ['open', 'in_progress', 'on_hold', 'resolved'];
      let target = get(/databases/$(database)/documents/projects/$(pid)/issues/$(d.mergedInto.iid)).data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'statusReason', 'mergedInto', 'updatedAt', 'updatedBy'])
        && myRole(pid) == 'admin'
        && resource.data.status in open
        && d.status == 'merged'
        && hasReason()
        && d.mergedInto.keys().hasOnly(['iid', 'number'])
        && d.mergedInto.iid is string && d.mergedInto.iid != iid
        && d.mergedInto.number is int
        && target.status in open
        && target.number == d.mergedInto.number;
    }

      // 削除：管理者のみ。削除フォルダにないものだけ。元のステータスと理由を残す
    function deleteAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'deletedFrom', 'deletedReason', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && (myRole(pid) == 'admin' || importUndoAllowed())
        && resource.data.status != 'deleted'
        && d.status == 'deleted'
        && d.deletedFrom == resource.data.status
        && d.deletedReason is string && d.deletedReason.size() > 0 && d.deletedReason.size() <= 1000
        && d.deletedBy == request.auth.uid
        && d.deletedAt == request.time;
    }

    // 復元：管理者（すべて）と、提起した本人。削除する前のステータスに戻すだけ
    function restoreAllowed(pid) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'deletedFrom', 'deletedReason', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && resource.data.status == 'deleted'
        && d.status == resource.data.get('deletedFrom', 'open')
        && !('deletedFrom' in d)
        && (myRole(pid) == 'admin' || resource.data.reporterId == request.auth.uid);
    }
    // 完全削除のときだけ、経緯とコメントも消せる（親の課題が削除フォルダにあり、アーカイブ中でないとき）
    function purgeChildAllowed(pid, iid) {
      return isAdmin(pid)
        && get(/databases/$(database)/documents/projects/$(pid)/issues/$(iid)).data.status == 'deleted'
        && get(projectPath(pid)).data.archived == false;
    }

    match /projects/{pid} {
      allow read: if isMember(pid);
      // 作成は、自分を管理者にするメンバー文書と同時のときだけ
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.issueSeq == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0

        && request.resource.data.name.size() <= 100
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string && request.resource.data.description.size() <= 5000))
        && getAfter(memberPath(pid)).data.role == 'admin';
      allow update: if (isAdmin(pid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'archived', 'labels', 'settings', 'formerMembers',
                      'archiveKind', 'archiveReason', 'archivedAt', 'archivedBy', 'description'])
          // 説明を変えたときだけ、文字列で5000字までかを確かめる
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description'])
              || (request.resource.data.description is string && request.resource.data.description.size() <= 5000))
          && request.resource.data.labels is list
          && request.resource.data.labels.size() <= 30
          // 設定を変えたときだけ、形と範囲を確かめる（ラベルだけの保存は、設定の中身に左右されない）
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings'])
              || validSettings(request.resource.data.settings))
          // 名前を変えたときだけ、作るときと同じ決まり（1〜100文字の文字列）を確かめる
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
              || (request.resource.data.name is string
                  && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100))
          // アーカイブ中は、解除しかできない（名前・設定・ラベルは、解除してから）
          && (resource.data.archived == false
              || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['archived', 'archiveKind', 'archiveReason', 'archivedAt', 'archivedBy']))
          // アーカイブ・解除するときは、その決まりを確かめる
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived']) || archiveOk()))
      // 課題の登録時の採番（1つ増やすだけ）
        || (canWrite(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['issueSeq'])
        && request.resource.data.issueSeq == resource.data.issueSeq + 1)
      // 自分から抜けるとき：自分の名前だけを formerMembers に残せる
        || (isMember(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['formerMembers'])
        && request.resource.data.formerMembers.diff(resource.data.get('formerMembers', {})).affectedKeys()
             .hasOnly([request.auth.uid]));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(pid);
        allow create: if signedIn() && uid == request.auth.uid && validMember(uid) && (
          // ① 新しいプロジェクトの作成者が、自分を管理者として登録する
          (request.resource.data.role == 'admin'
            && !exists(projectPath(pid))
            && getAfter(projectPath(pid)).data.createdBy == request.auth.uid)
          ||
          // ② メール確認済みの人が、自分宛ての招待を、招待されたロールのまま承諾する
          (emailVerified()
            && request.resource.data.role == get(myInvitationPath(pid)).data.role
            && !existsAfter(myInvitationPath(pid)))
        );
        // ① 自分の表示名・アイコンの写しだけ、本人が書き換えられる
        // ② 管理者は、自分以外の役割を変えられる（自分の役割は変えられない＝最後の管理者が必ず残る）
        allow update: if (signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 50)
          || (isAdmin(pid) && uid != request.auth.uid
          && get(projectPath(pid)).data.archived == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'member', 'viewer']);
        // 外す：管理者が自分以外を。抜ける：管理者以外が自分を（管理者は抜けられない）
        allow delete: if (isAdmin(pid) && uid != request.auth.uid)
          || (signedIn() && uid == request.auth.uid && resource.data.role != 'admin');
       }

      match /invitations/{email} {
        allow read: if isAdmin(pid);
        allow create: if isAdmin(pid)
          && email == request.resource.data.email
          && email == email.lower()
          && request.resource.data.role in ['admin', 'member', 'viewer']
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['email', 'role', 'projectName', 'invitedBy', 'invitedByName', 'createdAt'])
          && get(projectPath(pid)).data.archived == false
          // 見本のプロジェクトには招待できない（自分だけの練習場なので）
          && get(projectPath(pid)).data.get('sample', false) == false;
        // 取り消し（管理者）と、承諾・辞退（招待された本人）
        allow delete: if isAdmin(pid)
          || (emailVerified() && email == request.auth.token.email.lower());
      }
      // 管理ログ：管理者だけが読める。書くのは管理者と、自分から抜ける本人（type が leave のときだけ）
      match /adminLogs/{lid} {
        allow read: if isAdmin(pid);
        allow create: if request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && (isAdmin(pid)
            || (isMember(pid) && request.resource.data.type == 'leave'
                && request.resource.data.target == request.auth.uid)
            // 取り込み：メンバーも記録を残す（自分の取り込みだけ）
            || (canWrite(pid) && request.resource.data.type == 'import'
                && request.resource.data.target == request.auth.uid)
            // 自分の担当の引き継ぎ：メンバーも記録を残す（自分の担当だけ）
            || (canWrite(pid) && request.resource.data.type == 'handover'
                && request.resource.data.target == request.auth.uid));
      }

      // 定期課題の雛形：管理者だけが作る・直す・止める・消す（使う機能でオン・アーカイブ中でないとき）。
      // 読むのはメンバー全員。課題を作るのは関数（Admin なので、このルールは通らない）
      match /recurring/{rid} {
        function recurringOn() {
          return isAdmin(pid)
            && get(projectPath(pid)).data.archived == false
            && get(projectPath(pid)).data.settings.features.recurring == true;
        }
        function validRecurring() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'type', 'importance', 'assigneeId', 'doneCriteria', 'description',
                   'labelIds', 'freq', 'weekdays', 'monthDay', 'time', 'tz', 'dueDays', 'active', 'stopped',
                   'nextAt', 'lastAt', 'lastNumber', 'createdBy', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && d.type in ['bug', 'request', 'question', 'task', 'risk']
            && d.importance in ['high', 'mid', 'low']
            && d.doneCriteria is string && d.doneCriteria.size() > 0 && d.doneCriteria.size() <= 2000
            && d.description is string && d.description.size() <= 5000
            && d.labelIds is list && d.labelIds.size() <= 5
            && d.freq in ['daily', 'weekly', 'monthly']
            && d.weekdays is list && d.weekdays.size() <= 7
            && d.monthDay is int && d.monthDay >= 1 && d.monthDay <= 31
            && d.time is int && d.time >= 0 && d.time < 1440 && d.time % 10 == 0
            && d.tz is string && d.tz.size() <= 64
            && d.dueDays in [0, 1, 3, 7]
            && d.active is bool
            && d.nextAt is timestamp
            && d.updatedAt == request.time
            // 担当者は、このプロジェクトの管理者かメンバー
            && get(/databases/$(database)/documents/projects/$(pid)/members/$(d.assigneeId)).data.role in ['admin', 'member'];
        }
        allow read: if isMember(pid);
        allow create: if recurringOn() && validRecurring()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        // 作った人は、そのままか、直している管理者自身に替えるだけ（作った人が抜けた雛形を、引き取れるように）
        allow update: if recurringOn() && validRecurring()
          && (request.resource.data.createdBy == resource.data.createdBy
              || request.resource.data.createdBy == request.auth.uid)
          && request.resource.data.createdAt == resource.data.createdAt;
        // 消すのは、機能をオフにしたあとやアーカイブ中でも（片づけられるように）
        allow delete: if isAdmin(pid);
      }

      // 動きの帳面（概要の「直近の経緯」）。書くのは関数だけ。見るのはメンバー全員
      match /activity/{aid} {
        allow read: if isMember(pid);
        allow write: if false;
      }

      // プロジェクトの概要の添付（ファイル本体は Storage の projects/{pid}/overview/{fid}）。
      // 見るのはメンバー全員、置く・消すのは管理者（アーカイブ中は不可）。消すとファイル本体は関数が消す
      match /files/{fid} {
        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && get(projectPath(pid)).data.archived == false
          && request.resource.data.keys().hasOnly(['name', 'size', 'type', 'path', 'by', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.size is int
          && request.resource.data.size > 0 && request.resource.data.size <= 10 * 1024 * 1024
          && request.resource.data.type is string && request.resource.data.type.size() <= 200
          && request.resource.data.path == 'projects/' + pid + '/overview/' + fid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow delete: if isAdmin(pid) && get(projectPath(pid)).data.archived == false;
      }

      // 依頼（削除・統合・再開）：メンバーが管理者に頼む。管理者が「対応済み・見送り」にし、
      // 依頼した本人は取り下げられる。記録として残すので、だれも消せない
      match /requests/{rid} {
        function validRequest() {
          let d = request.resource.data;
          return d.keys().hasOnly(['kind', 'iid', 'number', 'title', 'targetIid', 'targetNumber',
                   'reason', 'by', 'byName', 'at', 'status'])
            && d.kind in ['delete', 'merge', 'reopen']
            && d.iid is string
            && exists(/databases/$(database)/documents/projects/$(pid)/issues/$(d.iid))
            && d.number is int
            && d.title is string && d.title.size() <= 200
            // 統合のときだけ、統合先が要る
            && (d.kind != 'merge' || (d.targetIid is string && d.targetNumber is int))
            && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 1000
            && d.by == request.auth.uid
            && d.byName is string && d.byName.size() <= 100
            && d.at == request.time
            && d.status == 'open';
        }
        allow read: if isMember(pid);
        // 頼めるのはメンバーだけ（管理者は自分でできる。閲覧者は課題を変えられないので頼まない）
        allow create: if canWrite(pid) && myRole(pid) == 'member' && validRequest();
        allow update: if
          // 管理者：対応済み・見送りにする（対応した人と日時を残す。見送りの一言は任意）
          (isAdmin(pid) && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'handledBy', 'handledAt', 'note'])
            && request.resource.data.status in ['done', 'declined']
            && request.resource.data.handledBy == request.auth.uid
            && request.resource.data.handledAt == request.time
            && request.resource.data.get('note', '') is string
            && request.resource.data.get('note', '').size() <= 1000)
          // 依頼した本人：取り下げる
          || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled');
        allow delete: if false;
      }

      match /issues/{iid} {
        // その配列で、増えた人・減った人が「自分だけ」か（ウォッチの付け外しで、ほかの人を足したり外したりできないように）
        function onlySelfChanged(k) {
          let before = resource.data.get(k, []).toSet();
          let after = request.resource.data.get(k, []);
          return after is list && after.size() <= 100
            && after.toSet().difference(before).hasOnly([request.auth.uid])
            && before.difference(after.toSet()).hasOnly([request.auth.uid]);
        }
        allow read: if isMember(pid);
        allow create: if canWrite(pid)
          && issueShapeOk(pid)
          && (normalCreateOk() || importCreateOk(pid));
        allow update: if canWrite(pid)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'statusReason', 'updatedAt', 'updatedBy', 'cause', 'countermeasure', 'causeCategory',
               'doneCriteriaMet', 'resolvedAt', 'effect', 'learning', 'closedAt', 'workaroundEnded', 'resolvedAssignee',
               'actualHours'])
             && statusChangeAllowed(pid))
            || editAllowed(pid)
            || priorityAllowed(pid)
            || causeAllowed(pid)
            || workaroundAllowed(pid)
            || deleteAllowed(pid)
            || mergeAllowed(pid, iid)
            || restoreAllowed(pid)
          );
        // ウォッチの付け外し：メンバー（閲覧者も）が、自分の uid だけを足す・外す。
        // updatedAt は変えない（停滞のリセットにも、衝突の判定にもしない）。アーカイブ中は不可
        allow update: if isMember(pid)
          && get(projectPath(pid)).data.archived == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watchers', 'muted'])
          && onlySelfChanged('watchers')
          && onlySelfChanged('muted');

        // 完全削除：管理者が、削除フォルダの中の課題だけ（アーカイブ中は不可）。元に戻せない
        allow delete: if isAdmin(pid)
          && resource.data.status == 'deleted'
          && get(projectPath(pid)).data.archived == false;

        match /events/{eid} {
          allow read: if isMember(pid);
          allow create: if canWrite(pid) && request.resource.data.by == request.auth.uid;
          allow delete: if purgeChildAllowed(pid, iid);
        }

                // コメントは閲覧者もできる（アーカイブ中は不可）
        match /comments/{cid} {
          allow read: if isMember(pid);
          allow create: if isMember(pid)
            && get(projectPath(pid)).data.archived == false
            && get(/databases/$(database)/documents/projects/$(pid)/issues/$(iid)).data.status != 'deleted'
            && request.resource.data.keys().hasOnly(['body', 'by', 'tz', 'at', 'mentions'])
            && (!('mentions' in request.resource.data)
                || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 20))
            && request.resource.data.by == request.auth.uid
            // 本文は空でもよい（ファイルだけのコメント。「本文かファイルのどちらかは要る」は画面で守る）
            && request.resource.data.body is string
            && request.resource.data.body.size() <= 5000
            && request.resource.data.at == request.time;
          // 直す・消す（消したコメントは対象外、アーカイブ中は不可）
          allow update: if isMember(pid)
            && get(projectPath(pid)).data.archived == false
            && resource.data.get('deleted', false) == false
            && (
              // 直す：書いた本人だけ。本文と直した日時だけ変えられる
              (resource.data.by == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 5000
                && request.resource.data.editedAt == request.time)
              ||
              // 消す：本人か管理者。本文を空にして、消した印を付ける
              ((resource.data.by == request.auth.uid || isAdmin(pid))
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['deleted', 'deletedBy', 'deletedAt', 'body'])
                && request.resource.data.deleted == true
                && request.resource.data.deletedBy == request.auth.uid
                && request.resource.data.deletedAt == request.time
                && request.resource.data.body == '')
            );
          // 文書そのものは、ふだんは誰も消せない（跡を残すため）。課題ごと完全削除するときだけ消せる
          allow delete: if purgeChildAllowed(pid, iid);
        }
        // 関連課題：両側に1枚ずつ。相手側の写し（in）は、対になる out と同じ保存でしか作れない・消せない
        match /links/{lid} {
          function linkPath(p, i, l) {
            return /databases/$(database)/documents/projects/$(p)/issues/$(i)/links/$(l);
          }
          // 相手側に置かれる、対の文書の名前（相手から見ると、こちらが「相手」）
          function pairId(kind, dir) { return kind + '_' + dir + '_' + pid + '_' + iid; }
          function validLink() {
            let d = request.resource.data;
            return d.keys().hasOnly(['kind', 'dir', 'pid', 'iid', 'by', 'at'])
              && d.kind in ['relates', 'recurrence', 'duplicate', 'waitsFor']
              && d.dir in ['out', 'in']
              && d.pid is string && d.iid is string
              && !(d.pid == pid && d.iid == iid)
              && lid == d.kind + '_' + d.dir + '_' + d.pid + '_' + d.iid
              && d.by == request.auth.uid
              && d.at == request.time
              // 同じ保存で生まれる課題も相手にできるように、「書いたあと」で確かめる
              && existsAfter(/databases/$(database)/documents/projects/$(d.pid)/issues/$(d.iid));
          }
          allow read: if isMember(pid);
          allow create: if validLink() && (
            // こちらから付ける：この課題のプロジェクトに書ける人。相手側の写しも同じ保存で作ること
            (request.resource.data.dir == 'out' && canWrite(pid)
              && existsAfter(linkPath(request.resource.data.pid, request.resource.data.iid,
                   pairId(request.resource.data.kind, 'in'))))
            // 相手側の写し：このプロジェクトのメンバーで、対の out が同じ保存でできること
            || (request.resource.data.dir == 'in' && isMember(pid)
              && get(projectPath(pid)).data.archived == false
              && existsAfter(linkPath(request.resource.data.pid, request.resource.data.iid,
                   pairId(request.resource.data.kind, 'out'))))
          );
          allow delete: if
            // こちらから外す：書ける人。相手側の写しも同じ保存で消すこと
            (resource.data.dir == 'out' && canWrite(pid)
              && !existsAfter(linkPath(resource.data.pid, resource.data.iid, pairId(resource.data.kind, 'in'))))
            // 相手側の写し：対の out が消えるなら（相手のプロジェクトを抜けたあとでも外せる）
            || (resource.data.dir == 'in' && signedIn()
              && !existsAfter(linkPath(resource.data.pid, resource.data.iid, pairId(resource.data.kind, 'out'))))
            // 完全削除のとき
            || purgeChildAllowed(pid, iid);
        }
        // サブタスク：課題を編集できる人が、足す・直す・消す・並べ替える。
        // 状態（□）だけは、そのサブタスクの担当者も変えられる
        match /subtasks/{sid} {
          function parentIssue() {
            return get(/databases/$(database)/documents/projects/$(pid)/issues/$(iid)).data;
          }
          // 親の課題を編集できるか（editAllowed と同じ決まり：管理者・提起者・担当者。クローズ・統合・削除は不可）
          function canEditParent() {
            let p = parentIssue();
            return canWrite(pid)
              && !(p.status in ['closed', 'deleted', 'merged'])
              && (myRole(pid) == 'admin' || p.reporterId == request.auth.uid || p.assigneeId == request.auth.uid);
          }
          // その項目を、今回の保存で決めたか（作るときは、すべて「決めた」扱い）
          function touched(k) {
            return request.method == 'create'
              || request.resource.data.diff(resource.data).affectedKeys().hasAny([k]);
          }
          function validSubtask() {
            let d = request.resource.data;
            return d.keys().hasOnly(['title', 'assigneeId', 'dueAt', 'status', 'memo', 'order',
                     'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'splitTo'])
              && d.title is string && d.title.size() > 0 && d.title.size() <= 200
              && d.status in ['todo', 'doing', 'done']
              && d.memo is string && d.memo.size() <= 2000
              && d.order is number
              && d.updatedAt == request.time
              && d.updatedBy == request.auth.uid
              // 担当者と期限は、決めたときだけ確かめる（あとで親の期限が早まった・担当者が抜けた、でも □ は押せるように）
              && (!touched('assigneeId')
                  || get(/databases/$(database)/documents/projects/$(pid)/members/$(d.assigneeId)).data.role in ['admin', 'member'])
              && (!touched('dueAt')
                  || d.get('dueAt', null) == null
                  || (d.dueAt is timestamp && d.dueAt <= parentIssue().dueAt));
          }

          allow read: if isMember(pid);

          allow create: if canEditParent()
            && validSubtask()
            && request.resource.data.keys().hasAll(['title', 'assigneeId', 'dueAt', 'status', 'memo', 'order'])
            && !('splitTo' in request.resource.data)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;

          allow update: if validSubtask()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            // 切り出しの印は1回だけ。付けるときは、切り出した課題が同じ保存でできていること
            && (!touched('splitTo')
                || (!('splitTo' in resource.data)
                    && request.resource.data.splitTo.keys().hasOnly(['iid', 'number'])
                    && existsAfter(/databases/$(database)/documents/projects/$(pid)/issues/$(request.resource.data.splitTo.iid))))
            && (
              canEditParent()
              // サブタスクの担当者：状態だけ
              || (canWrite(pid)
                && resource.data.assigneeId == request.auth.uid
                && !(parentIssue().status in ['closed', 'deleted', 'merged'])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']))
            );

          allow delete: if canEditParent() || purgeChildAllowed(pid, iid);
        }
        // 添付の一覧（ファイル本体は Storage）。課題への添付は管理者・メンバー、コメントへの添付は閲覧者も。
        // 消すのは置いた本人か管理者。ファイル本体は、文書が消えたら関数が消す
        match /attachments/{aid} {
          function issueStatus() {
            return get(/databases/$(database)/documents/projects/$(pid)/issues/$(iid)).data.status;
          }
          function validAttachment() {
            let d = request.resource.data;
            return d.keys().hasOnly(['name', 'size', 'type', 'path', 'cid', 'by', 'at'])
              && d.name is string && d.name.size() > 0 && d.name.size() <= 200
              && d.size is int && d.size > 0 && d.size <= 10 * 1024 * 1024
              && d.type is string && d.type.size() <= 200
              && d.by == request.auth.uid
              && d.at == request.time
              // 置き場所は、文書の名前と同じ id。課題へとコメントへで形が違う
              && ((d.get('cid', null) == null
                    && d.path == 'projects/' + pid + '/issues/' + iid + '/' + aid)
                || (d.get('cid', null) is string
                    && d.path == 'projects/' + pid + '/issues/' + iid + '/c/' + d.cid + '/' + aid));
          }
          allow read: if isMember(pid);
          allow create: if validAttachment()
            && get(projectPath(pid)).data.archived == false
            // 課題へ：書ける人（管理者・メンバー）で、クローズ・統合・削除フォルダの中ではない
            && ((request.resource.data.get('cid', null) == null && canWrite(pid)
                  && !(issueStatus() in ['closed', 'merged', 'deleted']))
              // コメントへ：メンバーなら閲覧者も。削除フォルダの中ではない（コメントの決まりと同じ）
              || (request.resource.data.get('cid', null) is string && isMember(pid) && issueStatus() != 'deleted'));
          allow delete: if (isMember(pid) && get(projectPath(pid)).data.archived == false
              && (resource.data.by == request.auth.uid || isAdmin(pid)))
            || purgeChildAllowed(pid, iid);
        }

      }
    }

    // 「自分が所属するプロジェクト一覧」の検索用
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invitations/{inviteId} {
      allow read: if emailVerified() && resource.data.email == request.auth.token.email.lower();
    }
    
    // 「自分の課題」は、プロジェクトごとに読む（projects/{pid}/issues のルールで、メンバーかどうかを確かめる）。
    // コレクショングループでまとめて読む決まりは、外れた人が担当だった課題を読めてしまうため、置かない
  }
}